/target
**/target
Cargo.lock.bak

# trunk / wasm build output
/apps/web/dist
/apps/admin/dist
/apps/game-client/dist
*.wasm

# generated: `cargo xtask gen-tokens` writes these. They ARE committed
# (CI fails if stale), so they are listed here only as a reminder — do not
# uncomment unless the generation story changes.
# /apps/web/style/tokens.css
# /crates/tabula-design/src/generated.rs

# built asset packs (sources live in games/<game>/assets/)
/games/*/assets/build

# local env / secrets
.env
.env.local
*.pem
deploy/**/*.secret.*

# editor
.idea/
.vscode/
*.swp
.DS_Store

# Python helpers bundled with agent skills
__pycache__/
*.py[cod]

# local verification output
/mutants.out/
/mutants.out.old/

# local perf/profiling output
perf.data*
flamegraph.svg

# mobile (Gradle / Kotlin)
/apps/mobile/.gradle/
/apps/mobile/.kotlin/
/apps/mobile/local.properties
/apps/mobile/**/build/

# Ephemeral native voice dev grant fixture: debug-only; never commit credentials.
/apps/mobile/voice-dev-grant.json

# Disposable provider public receipts are CI artifacts, not source
/verification/kanidm-oidc-artifacts/

# Disposable actual-browser receipts are CI artifacts, never source or secrets.
/verification/online-match-artifacts/
/verification/account-social-artifacts/

# Local Gradle diagnostics, signing fixtures and staged build output.
.gradle/
*.hprof
debug.keystore
debug.keystore.base64
app/build/
.build-outputs/
